#include <Winver.h>

#ifndef _DEBUG
#define DEBUG_FLAG 0
#else
#define DEBUG_FLAG VS_FF_DEBUG
#endif

#if defined SilikegoCore_EXPORTS
#define LIB_TYPE VFT_DLL
#else
#define LIB_TYPE VFT_STATIC_LIB
#endif

VS_VERSION_INFO  VERSIONINFO
FILEVERSION      @SilikegoCore_VERSION_MAJOR@,@SilikegoCore_VERSION_MINOR@,@SilikegoCore_VERSION_PATCH@,0
PRODUCTVERSION   @SilikegoCore_VERSION_MAJOR@,@SilikegoCore_VERSION_MINOR@,@SilikegoCore_VERSION_PATCH@,0
FILEFLAGSMASK    VS_FFI_FILEFLAGSMASK
FILEFLAGS        (DEBUG_FLAG|@PRERELEASE_FLAG@)
FILEOS           VOS__WINDOWS32
FILETYPE         LIB_TYPE
FILESUBTYPE      VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "No Company"
            VALUE "FileDescription",  "@SilikegoCore_DESCRIPTION@"
            VALUE "FileVersion",      "@SilikegoCore_VERSION@@SILIKEGO_CORE_PRERELEASE_SUFFIX@@SILIKEGO_CORE_PACKAGE_SUFFIX@"
            VALUE "InternalName",     "Silikego Core"
            VALUE "LegalCopyright",   "@SILIKEGO_CORE_COPYRIGHT@"
            VALUE "OriginalFilename", SILIKEGO_CORE_ORIGINAL_FILENAME
            VALUE "ProductName",      "Silikego Core"
            VALUE "ProductVersion",   "@SilikegoCore_VERSION@@SILIKEGO_CORE_PRERELEASE_SUFFIX@@SILIKEGO_CORE_PACKAGE_SUFFIX@"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
